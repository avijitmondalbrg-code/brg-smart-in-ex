rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure custom helpers (Pillar 3 & 4)
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z5-9a-zA-Z_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validator logic (Pillar 2)
    function isValidIncomeEntry(data) {
      return data.keys().hasAll([
        'id', 'patientName', 'patientId', 'date', 'serviceType', 
        'amountCollected', 'paymentMode', 'clinicLocation', 'billNo', 
        'expenses', 'createdTime'
      ])
      && data.id is string && data.id.size() <= 128
      && data.patientName is string && data.patientName.size() <= 200
      && data.patientId is string && data.patientId.size() <= 64
      && data.date is string && data.date.size() <= 32
      && data.serviceType is string && data.serviceType.size() <= 128
      && data.amountCollected is number
      && data.paymentMode is string && data.paymentMode.size() <= 64
      && data.clinicLocation is string && data.clinicLocation.size() <= 128
      && data.billNo is string && data.billNo.size() <= 64
      && data.createdTime is string && data.createdTime.size() <= 64
      && data.expenses is map;
    }

    match /entries/{entryId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidIncomeEntry(incoming());
      allow update: if isSignedIn() && isValidIncomeEntry(incoming());
      allow delete: if isSignedIn();
    }
  }
}

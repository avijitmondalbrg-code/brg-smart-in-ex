{
  "entities": {
    "income_entry": {
      "title": "Income Entry",
      "description": "Financial ledger clinical collection data representation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" },
        "patientId": { "type": "string" },
        "date": { "type": "string" },
        "serviceType": { "type": "string" },
        "amountCollected": { "type": "number" },
        "paymentMode": { "type": "string" },
        "notes": { "type": "string" },
        "clinicLocation": { "type": "string" },
        "billNo": { "type": "string" },
        "referredDoctor": { "type": "string" },
        "aslpName": { "type": "string" },
        "expenses": { "type": "object" },
        "createdTime": { "type": "string" },
        "selectedServices": { "type": "array" }
      },
      "required": ["id", "patientName", "patientId", "date", "serviceType", "amountCollected", "paymentMode", "clinicLocation", "billNo", "expenses", "createdTime"]
    },
    "app_settings": {
      "title": "App Settings",
      "description": "Global application branding and configuration",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/entries/{entryId}": {
      "schema": "income_entry",
      "description": "The collections of patient finances"
    },
    "/settings/{settingId}": {
      "schema": "app_settings",
      "description": "Global application configuration documents"
    }
  }
}
